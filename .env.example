# CareerPilot environment template — no real secrets belong here.
# Copy to .env (`make dev` does this automatically) and adjust locally.

# --- Application ---
APP_ENV=development
DEMO_MODE=true
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
FRONTEND_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# --- Infrastructure (hostnames match docker compose services) ---
# For a local venv outside Docker, replace `postgres`/`redis` with `localhost`.
DATABASE_URL=postgresql+psycopg://career:career_dev_only@postgres:5432/careerpilot
REDIS_URL=redis://redis:6379/0
POSTGRES_USER=career
POSTGRES_PASSWORD=career_dev_only
POSTGRES_DB=careerpilot

# --- Security / session ---
# Production requires a random value of at least 32 characters.
SESSION_SECRET=replace_with_random_secret
SESSION_COOKIE_NAME=careerpilot_session
AUTH_SESSION_TTL_DAYS=7
# Leave unset to auto-enable Secure when APP_ENV=production.
# COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
CSRF_COOKIE_NAME=careerpilot_csrf
CSRF_HEADER_NAME=X-CSRF-Token
# JSON list; defaults to FRONTEND_BASE_URL and API_BASE_URL.
CSRF_TRUSTED_ORIGINS=[]
# Login/registration throttling (Redis, fail-open on cache outage).
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_IP_ATTEMPTS=20
LOGIN_RATE_LIMIT_IP_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_ACCOUNT_ATTEMPTS=5
LOGIN_RATE_LIMIT_ACCOUNT_WINDOW_SECONDS=300
TRUST_PROXY_HEADERS=false
# Comma separated. Empty means nobody can trigger source syncs.
ADMIN_EMAILS=
# External account connections stay disabled unless providers are allow-listed.
EXTERNAL_AUTH_ALLOWED_PROVIDERS=[]
EXTERNAL_AUTH_ALLOW_BROWSER_SESSION=false
# JSON list; empty means FRONTEND_BASE_URL is used for CORS.
CORS_ORIGINS=[]

# --- Files ---
FILE_STORAGE_DIR=/app/uploads
MAX_RESUME_MB=10

# --- Optional LLM (OpenAI-compatible). Empty = Agent unavailable. ---
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0

# --- M4 LangGraph Agent runtime ---
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_GRAPH_STEPS=30
AGENT_MAX_RUNTIME_SECONDS=90
AGENT_MAX_SEARCH_CALLS=3

# --- Data sources ---
ENABLE_PUBLIC_CONNECTORS=false
JOB_SYNC_ENABLED=false
JOB_SYNC_INTERVAL_MINUTES=60
CONNECTOR_USER_AGENT=CareerPilotBot/0.1 (+https://careerpilot.local/bot)
CONNECTOR_TIMEOUT_SECONDS=20
CONNECTOR_MAX_RETRIES=2
CONNECTOR_BACKOFF_SECONDS=1
CONNECTOR_MIN_INTERVAL_SECONDS=1
CONNECTOR_MAX_PAGES=20
CONNECTOR_PAGE_SIZE=50
# Manual/authorized JSON imports (must be an official export you may use).
MANUAL_IMPORT_DIR=/app/fixtures/manual
# Alibaba TOP API: requires your own app_key/app_secret and partner tenant_id.
ALIBABA_APP_KEY=
ALIBABA_APP_SECRET=
ALIBABA_TENANT_ID=
ALIBABA_POSITION_URL_TEMPLATE=

# --- M2-R3 site-restricted discovery (Tavily only) ---
# Tavily is the only licensed search provider; the key is required for online search.
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=10
TAVILY_MAX_QUERIES_PER_REQUEST=20
TAVILY_MAX_QUERY_TERMS=3
TAVILY_EXTRACT_DEPTH=basic
TAVILY_EXTRACT_TIMEOUT_SECONDS=20
TAVILY_EXTRACT_DAILY_BUDGET=30
TAVILY_EXTRACT_CACHE_TTL_SECONDS=3600
SEARCH_MAX_QUERIES_PER_REQUEST=20
SEARCH_MAX_CONCURRENT_REQUESTS=4
SEARCH_TIMEOUT_SECONDS=10
SEARCH_MAX_RESULTS=10
SEARCH_RATE_LIMIT_PER_MINUTE=30
SEARCH_DAILY_BUDGET_PER_PROVIDER=100
SEARCH_CACHE_TTL_SECONDS=600
OFFICIAL_SITE_DISCOVERY_ENABLED=true
LEAD_VERIFY_RATE_LIMIT_PER_MINUTE=10

# --- M5.1 mailbox connections ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MAILBOX_SECRET_KEY=
MAILBOX_SYNC_ENABLED=true
MAILBOX_SYNC_INTERVAL_MINUTES=15
MAILBOX_SYNC_LOOKBACK_DAYS=30
MAILBOX_SYNC_MAX_MESSAGES=200
QQ_IMAP_HOST=imap.qq.com
QQ_IMAP_PORT=993
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
